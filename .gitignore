# Large or transient experiment output. Keep small result manifests in git.
artifacts/
checkpoints/
scratch/
wandb/
tensorboard/
results/**/raw/
results/**/checkpoints/
*.pt
*.pth
*.ckpt
*.npy
*.npz
*.pkl
*.pickle
*.h5
*.hdf5
*.mp4
*.webm

# Small checked-in numerical fixtures may be useful for reference parity.
!tests/fixtures/**/*.npy
!tests/fixtures/**/*.npz
